{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReplyReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "explicit_review"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "format": "uuid"
    },
    "intent": {
      "enum": [
        "acknowledged",
        "callback_requested",
        "operator_review"
      ]
    },
    "explicit_review": {
      "const": true
    }
  }
}
