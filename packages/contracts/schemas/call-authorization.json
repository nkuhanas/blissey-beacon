{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CallAuthorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preview_id",
    "context_hash",
    "expected_revision",
    "explicit_authorization"
  ],
  "properties": {
    "preview_id": {
      "type": "string",
      "format": "uuid"
    },
    "context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "explicit_authorization": {
      "const": true
    },
    "retry_of": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "message_preview_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_context_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "explicit_messaging_authorization": {
      "const": true
    }
  },
  "dependencies": {
    "message_preview_id": [
      "message_context_hash",
      "explicit_messaging_authorization"
    ],
    "message_context_hash": [
      "message_preview_id",
      "explicit_messaging_authorization"
    ],
    "explicit_messaging_authorization": [
      "message_preview_id",
      "message_context_hash"
    ]
  }
}
