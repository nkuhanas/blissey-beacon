{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessagePreviewRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contact_id",
    "expected_revision",
    "purpose"
  ],
  "properties": {
    "contact_id": {
      "type": "string",
      "format": "uuid"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "purpose": {
      "enum": [
        "followup",
        "update"
      ]
    },
    "update_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "verified_facts_confirmed": {
      "const": true
    },
    "staff_dispatch_confirmed": {
      "description": "Explicit operator confirmation that staff dispatch occurred for this incident; only valid for a follow-up preview. Records confirmation, does not dispatch staff.",
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "staff_dispatch_confirmed"
        ],
        "properties": {
          "staff_dispatch_confirmed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "purpose": {
            "const": "followup"
          }
        }
      }
    }
  ]
}
