{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageReview",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision",
    "evidence",
    "recipient_verified",
    "note",
    "explicit_authorization"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "evidence": {
      "enum": [
        "no_answer",
        "busy",
        "voicemail",
        "ended_before_message",
        "communicated"
      ]
    },
    "recipient_verified": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "explicit_authorization": {
      "const": true
    }
  }
}
