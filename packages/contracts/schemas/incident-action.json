{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IncidentAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expected_revision"
  ],
  "properties": {
    "expected_revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "acknowledged",
        "responding",
        "resolved"
      ]
    },
    "disposition": {
      "enum": [
        "reported_fall",
        "false_alarm",
        "unknown"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
