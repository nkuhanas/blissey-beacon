{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FamilyReply",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "incident_id",
    "contact_id",
    "body",
    "intent",
    "review_status",
    "received_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "incident_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "contact_id": {
      "type": "string",
      "format": "uuid"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "intent": {
      "enum": [
        "acknowledged",
        "callback_requested",
        "stop",
        "operator_review"
      ]
    },
    "review_status": {
      "enum": [
        "pending",
        "reviewed"
      ]
    },
    "received_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
