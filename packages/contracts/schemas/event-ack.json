{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EventAck",
  "type": "object",
  "properties": {
    "type": {
      "const": "event_ack"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "incident_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "accepted",
        "duplicate"
      ]
    }
  },
  "required": [
    "type",
    "event_id",
    "incident_id",
    "status"
  ],
  "additionalProperties": false
}
