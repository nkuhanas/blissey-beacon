{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MessageHistory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorizations",
    "messages",
    "replies"
  ],
  "properties": {
    "authorizations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "call_id",
          "state",
          "selection",
          "evidence",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "call_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "enum": [
              "waiting",
              "review",
              "queued",
              "cancelled",
              "submitted"
            ]
          },
          "selection": {
            "anyOf": [
              {
                "enum": [
                  "missed",
                  "summary",
                  "update"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "evidence": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "authorization_id",
          "body",
          "state",
          "error_code",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "authorization_id": {
            "type": "string",
            "format": "uuid"
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "state": {
            "enum": [
              "queued",
              "initiating",
              "accepted",
              "delivered",
              "read",
              "failed",
              "unknown",
              "cancelled"
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "replies": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "family-reply.json"
      }
    }
  }
}
