{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Explanation",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800
    },
    "recommended_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "event_id",
    "title",
    "description",
    "recommended_action"
  ],
  "additionalProperties": false
}
