# Deployment checklist. Set these in each provider's environment settings.
# Local apps load apps/backend/.env and apps/web/.env respectively.
# Never commit a populated .env or paste production credentials into chat.

# Railway backend only. Railway supplies PORT; do not hardcode it in production.
PORT=3001
WEB_ORIGIN=https://blissey-beacon.health
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Supabase direct or SESSION pooler connection, with certificate verification.
# Use a session-pooler URL if Railway cannot reach the direct IPv6 host.
DATABASE_URL=postgresql://YOUR_DB_USER:URL_ENCODED_PASSWORD@YOUR_DB_HOST:5432/postgres?sslmode=verify-full
# If the provider CA is required, configure Railway's SUPABASE_CA_CERT PEM variable
# and sslrootcert path/start command as described in docs/deployment.md.

# Vercel frontend only. These VITE_ values are PUBLIC at build time.
VITE_API_URL=https://api.blissey-beacon.health
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_FACILITY_ID=demo_facility

# Administrative device provisioning/simulator only; NOT frontend variables.
DEVICE_ID=pi_102
DEVICE_TOKEN=GENERATE_A_RANDOM_OPAQUE_TOKEN_OF_AT_LEAST_32_CHARACTERS
DEVICE_WS_URL=wss://api.blissey-beacon.health/api/devices/v1/stream
EVENT_ID=synthetic_evt_102

# Railway backend only. Configure BOTH to enable durable explanation processing.
# Leave unset to retain pending jobs without calling a provider. Never use VITE_ names.
# GEMINI_API_KEY=YOUR_SERVER_SIDE_GEMINI_API_KEY
# GEMINI_MODEL=gemini-3.5-flash-lite

# No Supabase service-role key is needed by the browser or backend runtime.
# Conversational call backend. Keep dispatch off until provider/agent setup is verified.
# Railway only. Never prefix these with VITE_.
NOTIFICATION_CALLS_ENABLED=false
# ELEVENLABS_API_KEY=YOUR_SERVER_SIDE_ELEVENLABS_API_KEY
# ELEVENLABS_AGENT_ID=YOUR_CONFIGURED_AGENT_ID
# ELEVENLABS_PHONE_NUMBER_ID=YOUR_ELEVENLABS_OUTBOUND_TRUNK_PHONE_NUMBER_ID
# ELEVENLABS_WEBHOOK_SECRET=YOUR_PROVIDER_WEBHOOK_SIGNING_SECRET
# Photon SIP credentials belong in the verified ElevenLabs trunk configuration.
# Photon project API credentials are additionally required server-side for hosted iMessage.

# Photon API project/key are runtime inputs for iMessage; SIP settings remain administrative.
# Project API key validates number/profile ownership. SIP credentials are stored
# in the approved ElevenLabs outbound trunk, not Vercel or browser bundles.
# PHOTON_PROJECT_ID=YOUR_PHOTON_PROJECT_ID
# PHOTON_API_KEY=YOUR_PROJECT_API_KEY
# PHOTON_CALLER_NUMBER=YOUR_PURCHASED_E164_CALLER_NUMBER
# PHOTON_SIP_HOST=sip.photon.codes
# PHOTON_SIP_PORT=5061
# PHOTON_SIP_USERNAME=YOUR_PHOTON_OUTBOUND_SIP_USERNAME
# PHOTON_SIP_PASSWORD=YOUR_PHOTON_OUTBOUND_SIP_PASSWORD

# Docker demo CLI: scripts/demo.sh. Keep these in ignored .env.deploy.local.
SMOKE_API_URL=https://api.blissey-beacon.health
SMOKE_FACILITY_ID=demo_facility
SMOKE_ROOM_ID=room_102
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
DEMO_OPERATOR_EMAIL=YOUR_PROVISIONED_DEMO_OPERATOR_EMAIL
DEMO_OPERATOR_PASSWORD=YOUR_PRIVATE_DEMO_OPERATOR_PASSWORD
# Exact allowlist match against an EXISTING saved, consented family contact.
# No phone number is provisioned by the script and no destination is accepted on CLI.
DEMO_FAMILY_PHONE_E164=YOUR_CONSENTED_TEST_RECIPIENT_E164

# Optional Railway management for dispatch status/on/off or --manage-dispatch.
# Project-scoped Railway token, not browser or runtime credentials.
# RAILWAY_TOKEN=YOUR_PROJECT_TOKEN
# RAILWAY_PROJECT_ID=YOUR_PROJECT_ID
# RAILWAY_ENVIRONMENT_ID=YOUR_ENVIRONMENT_ID
# RAILWAY_SERVICE_ID=YOUR_BACKEND_SERVICE_ID

# Photon hosted iMessage: sender assigned for this demo recipient (not the family phone).
# Keep keys server-side. Shared-line assignment and initial inbound onboarding are required.
PHOTON_IMESSAGE_SENDER_NUMBER=
# Independent from voice dispatch. Leave false until migrations, consent and API scopes are verified.
NOTIFICATION_MESSAGES_ENABLED=false

# Optional authenticated dashboard scenarios (Railway/backend only).
# Persist synthetic events through the existing incident/explanation pipeline.
# Never adds Pi credentials or fabricates device-health reports.
DEMO_SCENARIOS_ENABLED=false
DEMO_FACILITY_ID=demo_facility
# Set to the explicitly consented test recipient. Fictional family names remain visible.
# Used when creating missing fictional contacts; existing contacts/consent are preserved.
# DEMO_CONTACT_PHONE=YOUR_CONSENTED_TEST_RECIPIENT_E164
# Local development may reuse DEMO_FAMILY_PHONE_E164 above; never expose it as VITE_.
