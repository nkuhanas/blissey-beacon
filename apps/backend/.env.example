PORT=3001
WEB_ORIGIN=http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
# Supabase direct/session-pooler URL; require verified TLS. Never commit real values.
DATABASE_URL=postgresql://postgres:replace-me@your-database-host:5432/postgres?sslmode=verify-full

# Used only by pnpm --filter @blissey/backend provision:device.
# Provision a device row first. Generate a random token; do not use this placeholder.
# DEVICE_ID=pi_102
# DEVICE_TOKEN=replace-with-a-random-32-or-more-character-token

# Optional Gemini worker. Both values are required to enable it. Server-side only.
# GEMINI_API_KEY=replace-with-your-Gemini-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Voice calls stay off until actual Photon/ElevenLabs setup and evidence are verified.
NOTIFICATION_CALLS_ENABLED=false
# ELEVENLABS_API_KEY=replace-with-server-side-key
# ELEVENLABS_AGENT_ID=replace-with-configured-agent
# ELEVENLABS_PHONE_NUMBER_ID=replace-with-ElevenLabs-trunk-phone-number-id
# ELEVENLABS_WEBHOOK_SECRET=replace-with-provider-HMAC-secret
