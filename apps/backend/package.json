{
  "name": "@blissey/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/auth.test.ts tests/explanations.test.ts tests/notifications.test.ts tests/messages.test.ts",
    "test:db": "tsx --test tests/database.test.ts",
    "provision:device": "tsx --env-file-if-exists=.env src/provision-device.ts",
    "realtime:prepare": "node tests/prepare-realtime.ts",
    "test:realtime": "tsx --test tests/realtime.test.ts"
  },
  "dependencies": {
    "@blissey/contracts": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/websocket": "^11.0.0",
    "fastify": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.0.0",
    "tsx": "^4.0.0",
    "@types/ws": "^8.18.0",
    "@supabase/realtime-js": "^2.0.0",
    "@blissey/simulator": "workspace:*"
  }
}
